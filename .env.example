# ==============================================================================
# ExposureX Enterprise Environment Configuration Template
# Copy this file to .env and configure your environment-specific settings.
# ==============================================================================

# Core Application Settings
PROJECT_NAME=ExposureX
TAGLINE=SEE EXPOSURE. REDUCE RISK. STAY AHEAD.
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///./exposurex.db
DEMO_MODE=false

# ==============================================================================
# Intelligence Provider API Keys (Optional)
# The platform supports keyless operation with rate limits, or add keys for high throughput.
# ==============================================================================

# National Vulnerability Database (NIST NVD REST API v2)
# Free API Key obtainable at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Free Credential & Infostealer Intelligence Feeds (Keyless by default! Free keys optional)
# 1. XposedOrNot (Free open-source community breach database): https://xposedornot.com
# XPOSEDORNOT_API_KEY=

# 2. LeakCheck (Free Public Breach API): https://leakcheck.io/api
# LEAKCHECK_API_KEY=

# 3. Hudson Rock Cavalier (Free Infostealer Cybercrime Intelligence): https://www.hudsonrock.com/free-tools
# HUDSON_ROCK_API_KEY=

# Registered Enterprise SSO Domains (Comma-separated)
REGISTERED_DOMAINS=company.com,abc.com
